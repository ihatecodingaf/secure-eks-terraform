# Copy to backend.hcl (git-ignored) and run:
#   terraform init -backend-config=backend.hcl
#
# Create the bucket first with the stack in ./bootstrap.

bucket       = "REPLACE-ME-tfstate-123456789012"
key          = "secure-eks/dev/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # native S3 state locking, no DynamoDB table needed
